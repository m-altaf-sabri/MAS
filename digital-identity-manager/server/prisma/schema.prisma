generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityType {
  EMAIL
  PHONE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  DELETED
  UNKNOWN
}

enum RequestType {
  DELETE_DATA
  EXPORT_DATA
  CORRECT_DATA
  WITHDRAW_CONSENT
}

enum RequestStatus {
  DRAFT
  SENT
  WAITING
  RESOLVED
  REJECTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  passwordHash          String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  identities            Identity[]
  accounts              OnlineAccount[]
  privacyRequests       PrivacyRequest[]
  impersonationReports  ImpersonationReport[]
}

model Identity {
  id                    String        @id @default(uuid())
  userId                String
  type                  IdentityType
  encryptedValue        String
  normalizedValueHash   String
  maskedValue           String
  verified              Boolean       @default(false)
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts              OnlineAccount[]

  @@unique([userId, type, normalizedValueHash])
}

model OnlineAccount {
  id                    String        @id @default(uuid())
  userId                String
  identityId            String?
  serviceName           String
  username              String?
  profileUrl            String?
  category              String?
  status                AccountStatus @default(ACTIVE)
  privacyUrl            String?
  deleteAccountUrl      String?
  lastReviewedAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity              Identity?     @relation(fields: [identityId], references: [id], onDelete: SetNull)
  privacyRequests       PrivacyRequest[]
}

model PrivacyRequest {
  id                    String        @id @default(uuid())
  userId                String
  accountId             String?
  type                  RequestType
  status                RequestStatus @default(DRAFT)
  subject               String
  notes                 String?
  submittedAt           DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime      @default(now())

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               OnlineAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model ImpersonationReport {
  id                    String        @id @default(uuid())
  userId                String
  platform              String
  suspectedProfileUrl   String
  officialProfileUrl    String?
  reportType            String
  evidenceUrl           String?
  notes                 String?
  status                ReportStatus  @default(DRAFT)
  caseNumber            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}